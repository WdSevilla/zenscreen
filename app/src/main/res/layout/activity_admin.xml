<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZenScreen · Admin"
            android:textColor="#4f8ef7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Servidor WiFi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1d27"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVIDOR WIFI"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/serverUrlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obteniendo IP..."
                android:textColor="#4f8ef7"
                android:textSize="14sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Archivos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1d27"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARCHIVOS EN TABLET"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/fileCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#e2e8f0"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importUsbBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Importar desde almacenamiento"
                android:backgroundTint="#22263a"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Borrar seleccionados (0)"
                android:backgroundTint="#7f1d1d"
                android:textColor="#fca5a5"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⠿ Mantén y arrastra para reordenar"
                android:textColor="#3d4460"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Intervalo slideshow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1d27"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERVALO SLIDESHOW (segundos)"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/intervalSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="3"
                    android:valueTo="60"
                    android:stepSize="1" />

                <TextView
                    android:id="@+id/intervalLabel"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:textColor="#e2e8f0"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Orientación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1d27"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORIENTACIÓN DE PANTALLA"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrientPortrait"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Vertical"
                    android:textColor="#e2e8f0"
                    app:backgroundTint="#22263a"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrientLandscape"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Horizontal"
                    android:textColor="#e2e8f0"
                    app:backgroundTint="#22263a"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrientSensor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto"
                    android:textColor="#e2e8f0"
                    app:backgroundTint="#22263a"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

            </LinearLayout>
        </LinearLayout>

        <!-- Configuración avanzada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1d27"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIGURACIÓN AVANZADA"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑  Cambiar PIN de administrador"
                android:textColor="#e2e8f0"
                android:backgroundTint="#22263a"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐  Cambiar puerto del servidor WiFi"
                android:textColor="#e2e8f0"
                android:backgroundTint="#22263a"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeServerAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤  Cambiar usuario y contraseña WiFi"
                android:textColor="#e2e8f0"
                android:backgroundTint="#22263a" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setLauncherBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Establecer como launcher"
            android:textColor="#e2e8f0"
            android:backgroundTint="#22263a"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToKioskBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al kiosk"
            android:backgroundTint="#4f8ef7"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#3d4460"
            android:textSize="11sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
